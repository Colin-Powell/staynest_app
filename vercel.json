{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "test -n \"$VERCEL_GIT_COMMIT_REF\"",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}

{
  "name": "staynest-backend",
  "version": "0.1.0",
  "private": true,
  "description": "staynest API backend for property listings, auth, bookings, favorites and storage.",
  "type": "module",
  "scripts": {
    "start": "npm run migrate && node dist/index.js",
    "start:email-worker": "node dist/workers/emailWorker.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "test": "echo \"No backend tests configured yet. Add tests under backend/src/__tests__\" && exit 0",
    "seed": "node ./scripts/seed-admin.js",
    "migrate": "node ./scripts/apply-schema.js"
  },
  "bin": {},
  "dependencies": {
    "@types/node-cron": "^3.0.11",
    "axios": "^1.20.0",
    "bcrypt": "^5.1.0",
    "bullmq": "^5.81.4",
    "cloudinary": "^2.10.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.9.0",
    "firebase-admin": "^14.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "google-auth-library": "^9.0.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "lru-cache": "^11.5.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.5",
    "pg": "^8.11.1",
    "redis": "^6.2.1",
    "sharp": "^0.35.3",
    "socket.io": "^4.8.1",
    "update": "^0.7.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.0",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.19",
    "@types/express-rate-limit": "^5.1.3",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/morgan": "^1.9.4",
    "@types/multer": "^1.4.7",
    "@types/node": "^20.14.2",
    "@typescript-eslint/eslint-plugin": "^7.7.2",
    "@typescript-eslint/parser": "^7.7.2",
    "eslint": "^8.57.0",
    "prettier": "^3.0.0",
    "ts-node-dev": "^2.0.0",
    "tsx": "^3.12.7",
    "typescript": "^5.6.2"
  }
}

PORT=8080
# When running backend locally outside Docker, use localhost.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/staynest
# When running inside Docker compose, use db as the host.
# DATABASE_URL=postgresql://postgres:postgres@db:5432/staynest
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/staynest
JWT_SECRET=replace-with-strong-secret
CORS_ORIGIN=http://localhost:8080
STORAGE_PATH=uploads
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=120
CLOUDINARY_URL=cloudinary://<your_api_key>:<your_api_secret>@dpi5rsycs